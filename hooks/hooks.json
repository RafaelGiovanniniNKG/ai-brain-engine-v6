{
  "description": "ai-brain-engine-v6 — Passo 1: injeção no início da sessão + prova do que chegou ao modelo",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ["python", "${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py"],
            "timeout": 10000,
            "statusMessage": "carregando o contexto do projeto"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ["python", "${CLAUDE_PLUGIN_ROOT}/hooks/instructions_probe.py"],
            "timeout": 5000,
            "async": true
          }
        ]
      }
    ]
  }
}
