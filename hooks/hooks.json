{
  "description": "ai-brain-engine-v6 — injeção no início, guarda de commit, sensores por edição, o portão do encerramento e o diário automático",
  "_comentario": "Comando em STRING, com o caminho entre aspas. A forma de lista (exec) é documentada como mais segura para caminho com espaço, mas o PreToolUse a RECUSA — 'expected string, received array' — e um PreToolUse inválido derruba o carregamento do plugin inteiro, em silêncio para quem só testa os scripts na mão. Verifique com `claude plugin list` depois de mexer aqui.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"",
            "timeout": 10000,
            "statusMessage": "carregando o contexto do projeto"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/instructions_probe.py\"",
            "timeout": 5000,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/user_prompt.py\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guarda_commit.py\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/post_edit.py\"",
            "timeout": 30000,
            "statusMessage": "medindo o arquivo editado"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/post_bash.py\"",
            "timeout": 8000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_gate.py\"",
            "timeout": 10000,
            "statusMessage": "conferindo se há prova do que foi feito"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/gatilho_diario.py\"",
            "timeout": 8000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/gatilho_diario.py\"",
            "timeout": 8000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/gatilho_diario.py\"",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
