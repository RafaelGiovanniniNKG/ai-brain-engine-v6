{
  "description": "ai-brain-engine-v6 — injeção no início, sensores por edição e o portão que nega encerramento sem prova",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ["python", "${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py"],
            "timeout": 10000,
            "statusMessage": "carregando o contexto do projeto"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ["python", "${CLAUDE_PLUGIN_ROOT}/hooks/instructions_probe.py"],
            "timeout": 5000,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ["python", "${CLAUDE_PLUGIN_ROOT}/hooks/user_prompt.py"],
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": ["python", "${CLAUDE_PLUGIN_ROOT}/hooks/post_edit.py"],
            "timeout": 30000,
            "statusMessage": "medindo o arquivo editado"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": ["python", "${CLAUDE_PLUGIN_ROOT}/hooks/post_bash.py"],
            "timeout": 8000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ["python", "${CLAUDE_PLUGIN_ROOT}/hooks/stop_gate.py"],
            "timeout": 10000,
            "statusMessage": "conferindo se há prova do que foi feito"
          },
          {
            "type": "command",
            "command": ["python", "${CLAUDE_PLUGIN_ROOT}/hooks/gatilho_diario.py"],
            "timeout": 8000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ["python", "${CLAUDE_PLUGIN_ROOT}/hooks/gatilho_diario.py"],
            "timeout": 8000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ["python", "${CLAUDE_PLUGIN_ROOT}/hooks/gatilho_diario.py"],
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
