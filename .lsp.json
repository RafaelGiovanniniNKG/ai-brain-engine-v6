{
  "csharp": {
    "command": "csharp-ls",
    "extensionToLanguage": {
      ".cs": "csharp"
    },
    "diagnostics": true,
    "startupTimeout": 60000,
    "shutdownTimeout": 5000,
    "restartOnCrash": true,
    "maxRestarts": 3
  },
  "typescript": {
    "command": "typescript-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".mts": "typescript",
      ".cts": "typescript",
      ".js": "javascript",
      ".mjs": "javascript",
      ".cjs": "javascript"
    },
    "diagnostics": true,
    "startupTimeout": 30000,
    "restartOnCrash": true,
    "maxRestarts": 3
  }
}
